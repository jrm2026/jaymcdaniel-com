---
import { SITE, PILLARS } from '../lib/site';
---
<footer class="site">
  <div class="inner">
    <div>
      <div class="fmark">{SITE.name}</div>
      <p>Counsel to closely held businesses.</p>
      <p class="firm-name">
        <a href={SITE.firmUrl} target="_blank" rel="noopener noreferrer">{SITE.firmLegalName}</a>
      </p>
      <a class="profile-link" href={SITE.profileUrl} target="_blank" rel="noopener noreferrer">Attorney profile &rarr;</a>
    </div>
    <div>
      <h5>Pillars</h5>
      {PILLARS.map((p) => <a href={`/${p.slug}/`}>{p.label}</a>)}
    </div>
    <div>
      <h5>Follow</h5>
      <a href="/contact/">Contact</a>
      <a href="https://www.youtube.com/@CloselyHeld">@CloselyHeld · YouTube</a>
      <a href="https://www.linkedin.com/in/jayrmcdaniel">LinkedIn</a>
      <a href={SITE.profileUrl} target="_blank" rel="noopener noreferrer">Firm profile</a>
      <a href="/authorities/">Authorities</a>
    </div>
  </div>

  <div class="offices" aria-label="Office locations">
    {SITE.firmOffices.map((o) => (
      <address class="office">
        <span class="office-city">{o.city}</span>
        {o.lines.map((l) => <span>{l}</span>)}
        {o.phone && <a href={`tel:${o.phone.replace(/[^0-9]/g, '')}`}>{o.phone}</a>}
      </address>
    ))}
  </div>
  <div class="attorney-advertising" aria-label="Attorney advertising disclaimer">
    <h5>Attorney Advertising</h5>
    <p>
      The information on this site may be considered legal advertising under applicable laws and rules of professional conduct. The information here is of a general nature, is not intended to be and must not be considered legal advice, which is provided only to clients of the firm. You should consult a lawyer about legal issues. This site does not establish any attorney-client relationship. We are admitted to practice in the states of New Jersey and New York. The opinions expressed on this site are solely those of the author.
    </p>
  </div>
  <div class="redirect-note">thebusinessdivorcelawyer.com and valuationcounsel.law now redirect here — one hub, one archive, one name.</div>
</footer>
