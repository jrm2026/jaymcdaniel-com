---
import Search from 'astro-pagefind/components/Search.astro';
import { SITE, PILLARS, mailto } from '../lib/site';
import { pillarCounts, allTags } from '../lib/posts';
const counts = await pillarCounts();
// Cross-cutting tags shown under the pillars — only those with their own page.
const extraTopics = (await allTags()).filter((t) => t.promoted);
---
<aside>
  <div class="box accent">
    <h3>Have a specific question?</h3>
    <p class="subcopy">The articles cover the general question. For the one in front of you &mdash; a valuation, a dispute, an exit &mdash; email me directly. I read every message.</p>
    <a class="email-cta addr" href={mailto()}>{SITE.email}</a>
  </div>

  <div class="box search">
    <h3>Search</h3>
    <Search
      className="pf"
      searchboxOptions={{
        placeholder: 'Search the archive…',
        'show-images': 'false',
        'default-message': 'Type a topic, case name, or citation.',
      }}
    />
  </div>

  <div class="box">
    <div class="authorcard">
      <div class="avatar" aria-hidden="true">JM</div>
      <div>
        <div class="n">{SITE.authorName}</div>
        <div class="c">{SITE.authorCreds}</div>
      </div>
    </div>
    <p class="aboutcopy">Partner at {SITE.firm} and special valuation counsel to owners of closely held businesses. Three decades at the intersection of valuation, ownership disputes, and exit. <a href="/about/">About →</a></p>
  </div>

  <div class="box">
    <h3>Listen</h3>
    <div class="media">
      <a href="https://www.youtube.com/@CloselyHeld">@CloselyHeld →</a>
      <p>Short video breakdowns of the valuation and ownership questions behind the writing.</p>
    </div>
  </div>

  <div class="box">
    <h3>Browse by Topic</h3>
    <ul class="toplist">
      {PILLARS.map((p) => (
        <li><a href={`/${p.slug}/`}>{p.label} <span class="ct">{counts[p.label] ?? 0}</span></a></li>
      ))}
      {extraTopics.map((t) => (
        <li><a href={`/topic/${t.slug}/`}>{t.label} <span class="ct">{t.count}</span></a></li>
      ))}
      <li><a href="/topics/">All topics <span class="ct">&rarr;</span></a></li>
    </ul>
  </div>
</aside>

<style>
  /* Theme the Pagefind searchbox to the site palette. These --pf-* custom
     properties inherit into the component's shadow DOM. Matches /authorities/. */
  .box.search {
    --pf-font: var(--sans);
    --pf-background: var(--card);
    --pf-text: var(--ink);
    --pf-text-secondary: var(--muted);
    --pf-text-muted: var(--faint);
    --pf-border: var(--line);
    --pf-border-focus: var(--accent);
    --pf-outline-focus: var(--accent);
    --pf-hover: var(--paper);
    --pf-mark: var(--oxblood);
    --pf-border-radius: 6px;
  }
</style>
