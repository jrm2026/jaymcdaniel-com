---
import { SITE, PILLARS, tagSlug } from '../lib/site';
import { pillarCounts } from '../lib/posts';
const counts = await pillarCounts();
// Cross-cutting tag rows shown under the pillars in the topic list.
const extraTopics = ['Matrimonial', 'Tax Controversy'];
---
<aside>
  <div class="box accent">
    <h3>{SITE.newsletter}</h3>
    <p class="subcopy">One clear piece a week on what drives, protects, and realizes the value of a closely held business. Read by attorneys, owners, and advisors.</p>
    <!-- Replace action with your email provider's form endpoint (Kit / MailerLite / Buttondown). -->
    <form class="subform" action="#" method="post">
      <label for="sb-email" class="skip-link">Your email address</label>
      <input id="sb-email" type="email" name="email" placeholder="Your email address" required />
      <button type="submit">Subscribe free</button>
    </form>
  </div>

  <div class="box">
    <div class="authorcard">
      <div class="avatar" aria-hidden="true">JM</div>
      <div>
        <div class="n">{SITE.authorName}</div>
        <div class="c">{SITE.authorCreds}</div>
      </div>
    </div>
    <p class="aboutcopy">Partner at {SITE.firm} and special valuation counsel to owners of closely held businesses. Three decades at the intersection of valuation, ownership disputes, and exit. <a href="/about/">About →</a></p>
  </div>

  <div class="box">
    <h3>Listen</h3>
    <div class="media">
      <a href="https://www.youtube.com/@CloselyHeld">@CloselyHeld →</a>
      <p>Short video breakdowns of the valuation and ownership questions behind the writing.</p>
    </div>
  </div>

  <div class="box">
    <h3>Browse by Topic</h3>
    <ul class="toplist">
      {PILLARS.map((p) => (
        <li><a href={`/${p.slug}/`}>{p.label} <span class="ct">{counts[p.label] ?? 0}</span></a></li>
      ))}
      {extraTopics.map((t) => (
        <li><a href={`/topic/${tagSlug(t)}/`}>{t}</a></li>
      ))}
    </ul>
  </div>
</aside>
