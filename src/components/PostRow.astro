---
import type { Post } from '../lib/posts';
import { fmtDate, filterTokens } from '../lib/posts';
import { pillarByLabel } from '../lib/site';

interface Props { post: Post }
const { post } = Astro.props;
const { data, id } = post;
const topics = filterTokens(post, (label) => pillarByLabel(label)?.filter);
---
<article class="post" data-topic={topics}>
  <div class="meta-tag">{data.pillar}</div>
  <div class="body">
    <h2><a href={`/${id}/`} set:html={data.title}></a></h2>
    <p class="dek" set:html={data.dek ?? data.answerFirst}></p>
    <div class="pmeta">{fmtDate(data.date)}</div>
  </div>
</article>
