---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PostRow from '../../components/PostRow.astro';
import { allPosts } from '../../lib/posts';
import { SITE } from '../../lib/site';

const posts = await allPosts();
---
<BaseLayout
  title={`Articles — ${SITE.name}`}
  description="The full archive of Jay McDaniel's writing on valuation, business divorce, and exit &amp; succession."
  current="articles"
>
  <div class="wrap">
    <div class="layout">
      <div>
        <div class="headnote">
          <div class="kicker">The Archive</div>
          <h1>Every piece, one place.</h1>
          <p>The full feed across valuation, business divorce, and exit &amp; succession. Browse by topic in the sidebar, or narrow to a pillar from the navigation.</p>
        </div>


        <div id="posts">
          {posts.map((post) => <PostRow post={post} />)}
        </div>
      </div>

      <Sidebar />
    </div>
  </div>
</BaseLayout>
