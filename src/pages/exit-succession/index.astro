---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarLanding from '../../components/PillarLanding.astro';
import { SITE, pillarBySlug } from '../../lib/site';
const p = pillarBySlug('exit-succession')!;
---
<BaseLayout title={`${p.label} — ${SITE.name}`} description={p.headnote.slice(0, 155)} current="exit-succession">
  <PillarLanding slug="exit-succession" />
</BaseLayout>
